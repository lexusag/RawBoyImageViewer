// Signing. By default the app is signed ad hoc, so anyone can build it. On a Mac with an Apple certificate, put
// the team and identity in Config/Signing.local.xcconfig (git-ignored): a stable signature keeps macOS's permissions
// (removable drives, cloud folders) across rebuilds. See docs/releasing.md.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
